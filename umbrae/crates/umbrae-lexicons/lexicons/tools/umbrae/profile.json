{
  "lexicon": 1,
  "id": "tools.umbrae.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "An account's hidden profile, one copy per audience, each at key self: in the owner's followers space, a group or its everyone space (written by the owner), or in a community space (written by the member, in their own repo). Never in only-me. A viewer sees the copy for the narrowest audience they're in: a group, then followers, then a community, then everyone; ties go to the latest updatedAt. Blobs are fetched through space getBlob, never publicly.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "createdAt"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 640,
            "maxGraphemes": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2560,
            "maxGraphemes": 256
          },
          "pronouns": {
            "type": "string",
            "maxLength": 200,
            "maxGraphemes": 20,
            "description": "The short form, for readers that don't show sets. Kept in step with pronounSets."
          },
          "pronounSets": {
            "type": "array",
            "maxLength": 10,
            "items": {
              "type": "ref",
              "ref": "#pronounSet"
            },
            "description": "The full pronoun sets, as in app.nearhorizon.actor.pronouns. Empty shows nothing, and hides the short form too."
          },
          "pronounDisplayMode": {
            "type": "string",
            "knownValues": [
              "all",
              "firstOnly"
            ],
            "maxLength": 64,
            "description": "Absent or unknown reads as all."
          },
          "website": {
            "type": "string",
            "format": "uri",
            "description": "An https URL."
          },
          "links": {
            "type": "array",
            "maxLength": 10,
            "items": {
              "type": "ref",
              "ref": "#link"
            },
            "description": "Profile links, as on the public profile. Readers hide duplicates and general-purpose URL shorteners."
          },
          "avatar": {
            "type": "blob",
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "maxSize": 1000000
          },
          "avatarAlt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "maxGraphemes": 2000,
            "description": "Alt text for the avatar."
          },
          "banner": {
            "type": "blob",
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "maxSize": 1000000
          },
          "bannerAlt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "maxGraphemes": 2000,
            "description": "Alt text for the banner."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "When this copy last changed."
          }
        }
      }
    },
    "pronounSet": {
      "type": "object",
      "required": [
        "forms"
      ],
      "properties": {
        "forms": {
          "type": "array",
          "minLength": 1,
          "maxLength": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "maxGraphemes": 24
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "An https URL."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "maxGraphemes": 30
        },
        "icon": {
          "type": "blob",
          "accept": [
            "image/png",
            "image/jpeg"
          ],
          "maxSize": 1000000,
          "description": "The site's icon, fetched through space getBlob."
        }
      }
    }
  }
}
