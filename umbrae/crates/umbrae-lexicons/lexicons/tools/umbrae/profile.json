{
  "lexicon": 1,
  "id": "tools.umbrae.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "An account's hidden profile, shown only to its approved followers. Written by the authority at key self in its followers space (a tools.umbrae.space space with key followers). Blobs are fetched through space getBlob, never publicly.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "createdAt"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 640,
            "maxGraphemes": 64
          },
          "description": {
            "type": "string",
            "maxLength": 2560,
            "maxGraphemes": 256
          },
          "pronouns": {
            "type": "string",
            "maxLength": 200,
            "maxGraphemes": 20
          },
          "website": {
            "type": "string",
            "format": "uri",
            "description": "An https URL."
          },
          "avatar": {
            "type": "blob",
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "maxSize": 1000000
          },
          "banner": {
            "type": "blob",
            "accept": [
              "image/png",
              "image/jpeg"
            ],
            "maxSize": 1000000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
