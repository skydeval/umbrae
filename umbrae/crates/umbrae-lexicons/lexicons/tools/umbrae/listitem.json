{
  "lexicon": 1,
  "id": "tools.umbrae.listitem",
  "defs": {
    "main": {
      "type": "record",
      "description": "One account on a hidden list, next to the list. In only-me, list is the personal list's TID record key; in a shared list space it is absent. Names no hidden record.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did"
          },
          "list": {
            "type": "string",
            "format": "tid"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
