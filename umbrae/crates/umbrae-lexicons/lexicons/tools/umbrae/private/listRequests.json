{
  "lexicon": 1,
  "id": "tools.umbrae.private.listRequests",
  "defs": {
    "main": {
      "type": "query",
      "description": "The follow requests waiting for the caller, a private account this app serves. The owner only. Served and authenticated as tools.umbrae.private.requestFollow.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#request"
              }
            },
            "cursor": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AccountNotFound",
          "description": "The caller isn't a private account this app serves."
        }
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "did",
        "createdAt"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "handle": {
          "type": "string",
          "format": "handle"
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        }
      }
    }
  }
}
