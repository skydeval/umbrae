{
  "lexicon": 1,
  "id": "tools.umbrae.follow",
  "defs": {
    "main": {
      "type": "record",
      "description": "A hidden follow, kept in the follower's own only-me space. Feeds a hidden Following timeline. Separate from approval into a private account's followers space.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
